PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/lms
JWT_SECRET=replace_with_a_long_random_hex_secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

# Admin Credentials (used by server/seed.js; never commit real .env)
ADMIN_NAME=SkillCourse Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_min_12_char_password
ADMIN_PHONE=1234567890

# Checkout / Free UPI Payment Config & Webhook Automation
PAYMENT_UPI_ID=yourmerchant@upi
PAYMENT_UPI_NAME=SkillCourse Education
PAYMENT_BANK_NAME=Your Bank Name
PAYMENT_ACCOUNT_NUMBER=000000000000
PAYMENT_IFSC=BANK0001234
# Optional: set a strong random secret to enable automated UTR verification via POST /api/payments/upi-webhook
UPI_WEBHOOK_SECRET=
